# =============================================
# .env 템플릿 — 이 파일을 복사해 .env 로 저장하고 실제 키를 넣으세요
# (형식: KEY=값, 따옴표는 있어도 되고 없어도 됨, # 는 주석)
# =============================================

# OpenAI — Interpreter/Retriever/Summarizer/Evaluator/Critic 이 사용
OPENAI_API_KEY=sk-proj-...

# Anthropic — Improver(정책 개선안), LLM Judge 가 사용
ANTHROPIC_API_KEY=sk-ant-...

# (선택) 모델 오버라이드
# OPENAI_MODEL=gpt-5.2
# A2A_MODEL_SUMMARY=gpt-5.2
# A2A_MODEL_POLICY=claude-sonnet-5
# JUDGE_PROVIDER=anthropic
# JUDGE_MODEL=claude-sonnet-5

# (선택) VOC CSV 경로 오버라이드
# A2A_VOC_CSV=d:\voc\voc.csv
